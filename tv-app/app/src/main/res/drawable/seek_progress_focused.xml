<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:top="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="#4DFFFFFF" /><corners android:radius="5dp" /></shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:top="3dp" android:bottom="3dp">
        <scale android:scaleGravity="left|center_vertical" android:scaleWidth="100%">
            <shape android:shape="rectangle"><solid android:color="#80FFFFFF" /><corners android:radius="5dp" /></shape>
        </scale>
    </item>
    <item android:id="@android:id/progress" android:top="3dp" android:bottom="3dp">
        <scale android:scaleGravity="left|center_vertical" android:scaleWidth="100%">
            <shape android:shape="rectangle"><solid android:color="#FFFFFF" /><corners android:radius="5dp" /></shape>
        </scale>
    </item>
</layer-list>
