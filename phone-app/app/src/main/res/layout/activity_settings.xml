<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorSurface"
        app:navigationContentDescription="Back"
        app:navigationIcon="@drawable/ic_back"
        app:title="Settings"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Ping.SettingsHeader"
                android:text="Navigation bar" />

            <LinearLayout style="@style/Ping.SettingsItem">

                <TextView
                    style="@style/Ping.SettingsTitle"
                    android:text="Style" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/nav_style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nav_style_bottom"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Bottom" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nav_style_floating"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Floating" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <LinearLayout style="@style/Ping.SettingsItem">

                <TextView
                    style="@style/Ping.SettingsTitle"
                    android:text="Appearance" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/nav_look"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nav_look_solid"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Solid" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nav_look_frosted"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Frosted" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <TextView
                style="@style/Ping.SettingsHeader"
                android:text="Colors" />

            <LinearLayout
                android:id="@+id/row_device_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Ping.SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Use device colors" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_device_colors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Use device colors" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/item_accent"
                style="@style/Ping.SettingsItem">

                <TextView
                    style="@style/Ping.SettingsTitle"
                    android:text="Accent color" />

                <LinearLayout
                    android:id="@+id/accent_swatches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:id="@+id/header_about"
                style="@style/Ping.SettingsHeader"
                android:text="About" />

            <LinearLayout
                android:id="@+id/row_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Ping.SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="About Ping!" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_open_in_new"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
